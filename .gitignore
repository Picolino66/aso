build/

# Runtime do manager.sh (PID/log da API local)
.aso/run/

# Perfis de executor (config local, contém caminhos absolutos da máquina)
.aso/executors.json

# Worktrees dos cards. O runtime injeta esta mesma linha no .gitignore dos repos-alvo
# (WorkspaceService.ensure_git); faltava aqui, e o próprio ASO já foi alvo de orquestração.
.aso/worktrees/

# Banco SQLite local. `alembic` sem ASO_DATABASE_URL cai no fallback `sqlite:///aso.db`
# (migrations/env.py) e cria este arquivo na raiz — é estado de runtime, não código.
aso.db
*.sqlite
*.sqlite3
